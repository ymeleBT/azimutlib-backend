# Copy to .env for local development. On Railway, set these as service Variables
# instead (Project -> your service -> Variables) - never commit real secrets.

# --- Database ---
# If you add Railway's MySQL plugin to this project, you can either:
#   (a) leave DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME unset and instead set
#       Railway variable references DB_HOST=${{MySQL.MYSQLHOST}} etc. in the
#       dashboard, or
#   (b) do nothing - application.yml already falls back to Railway's own
#       MYSQLHOST/MYSQLPORT/MYSQLUSER/MYSQLPASSWORD/MYSQLDATABASE variables
#       automatically when DB_HOST etc. aren't set.
DB_HOST=localhost
DB_PORT=3306
DB_USER=library_user
DB_PASSWORD=library_pass
DB_NAME=library_db

# --- Server ---
# Railway injects PORT automatically at runtime - do not set this on Railway.
SERVER_PORT=8081

# --- Auth ---
# Generate a real 256-bit+ secret for production, e.g.: openssl rand -base64 32
JWT_SECRET=change-this-to-a-long-random-secret-in-production-min-256-bits
JWT_EXPIRATION_MS=86400000

# --- CORS ---
# Comma-separated list of allowed frontend origins, e.g. your deployed Angular app.
#CORS_ALLOWED_ORIGINS=http://localhost:4200 #LOCAL
CORS_ALLOWED_ORIGINS=https://azimutlib.dmsacad.com # When deployed to GitHub Pages, or your own domain if you have one.

# --- Mail (optional; leave MAIL_USERNAME/MAIL_PASSWORD blank to disable) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Notifications / uploads ---
SMS_ENABLED=false
# On Railway, mount a Volume at /data and point this at it, or uploaded files
# (avatars, teaching resources) are lost on every redeploy.
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE=100MB
UPLOAD_MAX_REQUEST_SIZE=100MB
